# Copy to deploy.local.env (repo root) or NewServerConfig/deploy.local.env

DO_HOST=161.35.69.206
PUBLIC_URL=https://smolyanvote.com
DO_USER=root

# Optional: path to OpenSSH private key. Leave empty to use ssh-agent / default key.
DO_SSH_KEY=

# Server directory with docker-compose.prod.yml, .env, Caddyfile
REMOTE_DIR=/opt/smolyanvote/server

# Requirements on this PC (no Docker needed):
#   Java 17+, Node.js 22+, npm, OpenSSH (ssh/scp), tar
#
# Server stack (deploy/): backend + frontend + monitor scraper + Caddy
# Secrets: NewServerConfig/.env (GEMINI_API_KEY, DB_PASSWORD, …)
# Optional: NewServerConfig/firebase-service-account.json
#
# Optional: scp retries for large uploads (default 3)
# SCP_RETRY_COUNT=5

# Faster deploy flags (see deploy.bat output):
#   deploy.bat --backend-only     Java/API changes only (~30s–1min)
#   deploy.bat --frontend-only    UI changes only (~2–4min after first build)
#   deploy.bat --skip-build       Re-upload last .deploy/artifacts without compiling
#
# After deploy: open /monitor, then Admin → Monitor → Ingestion → SIGMA import
