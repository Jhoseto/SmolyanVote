# Browser talks to Next (:3000). Leave API/WS empty/relative so fetch goes same-origin;
# next.config.ts rewrites proxy to Spring.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=/ws-svmessenger

# Spring backend (OAuth + rewrite destination). Browser never uses this for normal API calls.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:2662
API_INTERNAL_URL=http://localhost:2662

NEXT_PUBLIC_LIVEKIT_URL=wss://smolyanvote-nq17fbx3.livekit.cloud

# Optional Playwright authenticated flows (tests/e2e/authenticated-flows.spec.ts)
# E2E_USER_EMAIL=you@example.com
# E2E_USER_PASSWORD=secret
