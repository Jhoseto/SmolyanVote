# Production Caddy.
# Use https://161-35-69-206.sslip.io until smolyanvote.com DNS exists.
# Raw IP HTTPS fails on Windows Chrome (no SNI) — use sslip.io or http://161.35.69.206

{
	auto_https disable_redirects
}

(app) {
	encode gzip

	handle /api/* {
		reverse_proxy backend:2662
	}
	handle /admin/api/* {
		reverse_proxy backend:2662
	}
	handle /ws* {
		reverse_proxy backend:2662
	}
	handle /oauth2/* {
		reverse_proxy backend:2662
	}
	handle /login/oauth2/* {
		reverse_proxy backend:2662
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# HTTP by IP or hostname (no TLS redirect).
:80 {
	import app
}

# HTTPS with real cert (Let's Encrypt) — works in Chrome on Windows.
161-35-69-206.sslip.io {
	import app
}

# --- After smolyanvote.com DNS A → this server, uncomment: ---
# smolyanvote.com {
# 	import app
# }
# www.smolyanvote.com {
# 	redir https://smolyanvote.com{uri} permanent
# }
