# Replace smolyanvote.com with your domain. TLS via Caddy automatic HTTPS.
# IP: HTTP serves the app; HTTPS uses self-signed cert until DNS + Let's Encrypt.

{
	auto_https disable_redirects
}

(app) {
	encode gzip

	handle /api/* {
		reverse_proxy backend:2662
	}
	handle /admin/api/* {
		reverse_proxy backend:2662
	}
	handle /ws* {
		reverse_proxy backend:2662
	}
	handle /oauth2/* {
		reverse_proxy backend:2662
	}
	handle /login/oauth2/* {
		reverse_proxy backend:2662
	}

	handle {
		reverse_proxy frontend:3000
	}
}

:80 {
	@domain host smolyanvote.com www.smolyanvote.com
	handle @domain {
		redir https://{host}{uri} permanent
	}

	import app
}

https://161.35.69.206 {
	tls internal
	import app
}

smolyanvote.com {
	import app
}

www.smolyanvote.com {
	redir https://smolyanvote.com{uri} permanent
}
