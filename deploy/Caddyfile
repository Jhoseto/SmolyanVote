# Production Caddy — smolyanvote.com (Cloudflare A → 161.35.69.206)
# Caddy auto-issues Let's Encrypt certs for smolyanvote.com + www.
# Cloudflare: keep DNS-only (grey cloud) until https://smolyanvote.com works, then Proxied + Full (strict).

{
	# Optional: LE expiry notices (uncomment and set a real inbox)
	# email smolyanvote@gmail.com
}

(app) {
	encode gzip zstd

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), interest-cohort=()"
	}

	handle /api/* {
		reverse_proxy backend:2662
	}
	handle /admin/api/* {
		reverse_proxy backend:2662
	}
	handle /ws* {
		reverse_proxy backend:2662
	}
	handle /oauth2/* {
		reverse_proxy backend:2662
	}
	handle /login/oauth2/* {
		reverse_proxy backend:2662
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Primary site — HTTPS + HTTP→HTTPS redirect (automatic)
smolyanvote.com {
	import app
}

www.smolyanvote.com {
	redir https://smolyanvote.com{uri} permanent
}

# Emergency / pre-cutover fallback (optional; safe to remove later)
161-35-69-206.sslip.io {
	import app
}

# Raw IP — HTTP only (browsers cannot get TLS cert for bare IP)
http://161.35.69.206 {
	import app
}
