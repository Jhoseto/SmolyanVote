# Copy to .env on the Droplet:  cp env.example .env  &&  nano .env
# deploy.bat uploads NewServerConfig/.env when present.

# --- Public URL (required for OAuth redirects, emails, monitor links) ---
SMOLYANVOTE_FRONTEND_URL=https://smolyanvote.com

# --- Cloudflare DNS (smolyanvote.com) ---
# A records: @ and www → Droplet IPv4 (161.35.69.206), start with DNS only (grey cloud).
# After deploy + https://smolyanvote.com loads: SSL/TLS → Full (strict), then Proxied (orange) optional.
# Google/Facebook OAuth: add https://smolyanvote.com/login/oauth2/code/{google|facebook}

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod

# --- Database (Railway MySQL) ---
DB_PASSWORD=

# --- JWT (min 32 chars) ---
JWT_SECRET=

# --- Cloudinary ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mailjet ---
MAILJET_API_KEY=
MAILJET_API_SECRET=

# --- SightEngine moderation ---
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://smolyanvote-nq17fbx3.livekit.cloud

# --- Gemini (monitor AI batch + messenger translation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Граждански монитор ---
# Scraper sidecar URL inside Docker network (default set in docker-compose.prod.yml)
# MONITOR_SCRAPER_URL=http://scraper:3099
# Scheduled ingestion (cron Europe/Sofia: SIGMA 04:00, EOP 05:00, scrape 06:00, AI 06:30)
# MONITOR_INGESTION_SCHEDULER_ENABLED=true
# MONITOR_INGESTION_SIGMA_ENABLED=true
# MONITOR_INGESTION_EOP_ENABLED=true
# MONITOR_INGESTION_SCRAPE_ENABLED=true
# MONITOR_INGESTION_AI_BATCH_ENABLED=true

# --- JVM (2 GB Droplet — leave swap enabled via setup-droplet.sh) ---
# JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m

# --- Firebase push ---
FIREBASE_SERVICE_ACCOUNT_KEY=/app/firebase-service-account.json

# --- Master admin ---
MASTER_ADMIN_EMAIL=smolyanvote@gmail.com
