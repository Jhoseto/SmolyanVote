# Copy to .env (same directory). File is gitignored — used locally via spring-dotenv.

# Google AI Studio / Gemini API key (required for monitor AI batch + messenger translation)
GEMINI_API_KEY=

# Batch summaries: fast + cheap. Alternatives: gemini-2.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
